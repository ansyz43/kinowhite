---
import Layout from "../layouts/Layout.astro";

// Все фото сезонов — для ленты "Фотохроника сезона" под winners
const PHOTOS_2024 = [
  "3K6A1134","3K6A1301","3K6A1358","3K6A1474","3K6A1931","3K6A2040",
  "3K6A2231","3K6A2517","3K6A2829","3K6A3186","3K6A3214",
].map(n => `/assets/gallery/2024/${n}_resized.jpg`);

const PHOTOS_2025 = [
  "LX3A5728","LX3A5732","LX3A5740","LX3A5746","LX3A5765","LX3A5778",
  "LX3A5786","LX3A5961","LX3A6180","LX3A6184","LX3A6215","LX3A6248",
  "LX3A6615","LX3A6620","LX3A6647","LX3A6690",
].map(n => `/assets/gallery/2025/${n}_resized.jpg`);

type Winner = {
  num: string;        // I, II, III, IV, V, VI
  cat: string;        // короткая категория для тега справа
  title: string;
  author: string;
  year: string;
  region: string;
};

type Album = { year: string; label: string; place: string; date: string; winners: Winner[] };

const albums: Album[] = [
  {
    year: "2024",
    label: "I сезон",
    place: "Москва",
    date: "Декабрь 2024",
    winners: [
      { num: "I",   cat: "Полный метр",         title: "Сто лет тому вперёд", author: "Алексей Нужный",   year: "2024", region: "Якутия / Приморье" },
      { num: "II",  cat: "Режиссура",           title: "Айта",                author: "Степан Бурнашёв",  year: "2022", region: "Якутия" },
      { num: "III", cat: "Сценарий",            title: "Не одна дома",        author: "Радда Новикова",   year: "2023", region: "Сахалин" },
      { num: "IV",  cat: "Дебют",               title: "Куба, Куба",          author: "Кирилл Кравченко", year: "2024", region: "Приморье" },
      { num: "V",   cat: "Короткий метр",       title: "Тойук",               author: "Виктор Аммосов",   year: "2023", region: "Якутия" },
      { num: "VI",  cat: "За вклад",            title: "Дмитрий Давыденко",   author: "Продюсер",         year: "Якутск", region: "Якутия" },
    ],
  },
  {
    year: "2025",
    label: "II сезон",
    place: "Улан-Удэ",
    date: "Сентябрь 2025",
    winners: [
      { num: "I",   cat: "Полный метр",         title: "Огонь",                      author: "Алексей Нужный",      year: "2024", region: "Камчатка" },
      { num: "II",  cat: "Режиссура",           title: "Чёрная молния возвращается", author: "Дмитрий Давыдов",     year: "2024", region: "Якутия" },
      { num: "III", cat: "Сценарий",            title: "Бэлэх",                      author: "Степан Бурнашёв",     year: "2024", region: "Якутия" },
      { num: "IV",  cat: "Дебют",               title: "Триозёрск",                  author: "Сергей Кузнецов",     year: "2024", region: "Хабаровск" },
      { num: "V",   cat: "Короткий метр",       title: "Куда мы едем",               author: "Татьяна Эверстова",   year: "2024", region: "Якутия" },
      { num: "VI",  cat: "За вклад",            title: "Алёна Шумакова",             author: "Программный директор", year: "Бурятия", region: "Бурятия" },
    ],
  },
];
---
<Layout title={`Архив · Дальневосточная Кинопремия 2026`} active={"archive"}>

<section class="page-hero v2">
  <div class="page-hero-eyebrow"><span class="dot"></span><span>Архив победителей</span></div>
  <h1 class="page-hero-title" data-text-reveal>Два <em>сезона</em></h1>
  <p class="page-hero-lead">Шорт-листы и&nbsp;победители прошедших церемоний — I&nbsp;сезон в&nbsp;Москве (2024) и&nbsp;II&nbsp;сезон в&nbsp;Улан-Удэ (2025). Сезон III&nbsp;откроется после приёма заявок 2026.</p>
</section>

<!-- Year scrubber slider -->
<nav class="archive-nav-pills">
  {albums.map((a) => (
    <a href={"#year-" + a.year} class="archive-nav-pill">
      <span class="archive-nav-pill-year">{a.year}</span>
      <span class="archive-nav-pill-place">{a.place}</span>
    </a>
  ))}
</nav>

{albums.map((album) => (
  <article class="album-block reveal" id={"year-" + album.year}>

    <!-- Заголовок сезона — текстовый, с горизонтальной золотой линией -->
    <header class="album-header">
      <div class="album-header-eyebrow"><span class="dot"></span><span>{album.label} · {album.place}</span></div>
      <div class="album-header-main">
        <h2 class="album-header-year">{album.year}</h2>
        <span class="album-header-line"></span>
        <div class="album-header-meta">
          <span>{album.date}</span>
          <span>·</span>
          <span>{album.winners.length} лауреатов</span>
        </div>
      </div>
    </header>

    <!-- Победители — список в стиле наших номинаций (с линиями) -->
    <div class="nom-list reveal-stagger">
      {album.winners.map((w) => (
        <article class="nom-row">
          <div class="nom-num">{w.num}</div>
          <div class="nom-body">
            <h3>{w.title}</h3>
            <p>{w.author} · {w.year} · регион — {w.region}</p>
          </div>
          <div class="nom-meta">{w.cat}</div>
        </article>
      ))}
    </div>

    <!-- Фотохроника сезона — горизонтальная лента всех фото года -->
    <section class="album-photos">
      <header class="album-photos-head">
        <div class="page-hero-eyebrow"><span class="dot"></span><span>Фотохроника · {album.year}</span></div>
        <h3>Кадры <em>{album.label}</em></h3>
        <p>{album.year === "2024" ? PHOTOS_2024.length : PHOTOS_2025.length} фотографий · {album.place} · {album.date}</p>
      </header>
      <div class="album-photos-rail">
        {(album.year === "2024" ? PHOTOS_2024 : PHOTOS_2025).map((src, i) => (
          <button
            type="button"
            class="album-photos-card"
            data-lightbox-group={album.year}
            data-lightbox-index={i}
            aria-label={`Открыть фото ${i + 1}`}
          >
            <img src={src} alt="" loading="lazy" />
            <span class="album-photos-card-hover">
              <span class="album-photos-card-icon" aria-hidden="true">⤢</span>
              <span class="album-photos-card-text">{i + 1} / {album.year === "2024" ? PHOTOS_2024.length : PHOTOS_2025.length}</span>
            </span>
          </button>
        ))}
      </div>
    </section>

  </article>
))}

<!-- Lightbox: единый модальный просмотрщик для обеих фотохроник -->
<div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-label="Просмотр фото">
  <button type="button" class="lightbox-close" data-lightbox-close aria-label="Закрыть">×</button>
  <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Предыдущее фото">‹</button>
  <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Следующее фото">›</button>
  <figure class="lightbox-stage">
    <img class="lightbox-img" data-lightbox-img alt="" />
    <figcaption class="lightbox-caption" data-lightbox-caption></figcaption>
  </figure>
</div>

<script is:inline define:vars={{ photos2024: PHOTOS_2024, photos2025: PHOTOS_2025 }}>
  (function() {
    const GROUPS = { "2024": photos2024, "2025": photos2025 };
    const root = document.querySelector("[data-lightbox]");
    if (!root) return;
    const imgEl = root.querySelector("[data-lightbox-img]");
    const capEl = root.querySelector("[data-lightbox-caption]");
    let active = null; // { group, index }

    function open(group, index) {
      active = { group, index };
      render();
      root.hidden = false;
      root.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => root.classList.add("is-open"));
    }
    function close() {
      root.classList.remove("is-open");
      root.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => { root.hidden = true; active = null; }, 250);
    }
    function step(delta) {
      if (!active) return;
      const list = GROUPS[active.group];
      if (!list || !list.length) return;
      active.index = (active.index + delta + list.length) % list.length;
      render();
    }
    function render() {
      if (!active) return;
      const list = GROUPS[active.group];
      const src = list[active.index];
      imgEl.src = src;
      imgEl.alt = `Фото ${active.index + 1} из ${list.length}`;
      capEl.textContent = `${active.group} · ${active.index + 1} / ${list.length}`;
    }

    document.addEventListener("click", (e) => {
      const card = e.target.closest("[data-lightbox-group]");
      if (card) {
        e.preventDefault();
        open(card.dataset.lightboxGroup, Number(card.dataset.lightboxIndex) || 0);
        return;
      }
      if (e.target.closest("[data-lightbox-close]")) { close(); return; }
      if (e.target.closest("[data-lightbox-prev]"))  { step(-1); return; }
      if (e.target.closest("[data-lightbox-next]"))  { step(+1); return; }
      // клик на фон (не на изображение/кнопки) — закрыть
      if (e.target === root) close();
    });
    document.addEventListener("keydown", (e) => {
      if (root.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft")  step(-1);
      else if (e.key === "ArrowRight") step(+1);
    });

    // Свайпы на мобиле
    let touchX = null;
    root.addEventListener("touchstart", (e) => {
      touchX = e.changedTouches[0].clientX;
    }, { passive: true });
    root.addEventListener("touchend", (e) => {
      if (touchX === null) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 40) step(dx < 0 ? +1 : -1);
      touchX = null;
    }, { passive: true });
  })();
</script>

</Layout>
