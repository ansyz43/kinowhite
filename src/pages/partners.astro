---
import Layout from "../layouts/Layout.astro";

type Partner = { abbr: string; logo: string; name: string; role: string; invert?: boolean };
const partners: Partner[] = [
  { abbr: "МВР",  logo: "/media/partners/mvr.png",             invert: true, name: "Министерство Российской Федерации по&nbsp;развитию Дальнего Востока и&nbsp;Арктики", role: "Учредитель" },
  { abbr: "КРДВ", logo: "/media/partners/krdv.png",                          name: "Корпорация развития Дальнего Востока и&nbsp;Арктики", role: "Учредитель" },
  { abbr: "МК",   logo: "/media/partners/minkult.jpg",                       name: "Министерство культуры Российской Федерации", role: "При поддержке" },
  { abbr: "ХК",   logo: "/media/partners/khabarovsk-kray.png",               name: "Правительство Хабаровского края", role: "Регион" },
  { abbr: "ХБР",  logo: "/media/partners/khabarovsk-gerb.png",               name: "Администрация г.&nbsp;Хабаровск", role: "Город" },
  { abbr: "СР",   logo: "/media/partners/serdce-russkogo.png",               name: "ООО «Сердце Русского»", role: "Оператор" },
];
---
<Layout title={`Партнёры · Дальневосточная Кинопремия 2026`} active={"partners"}>

<section class="page-hero v2">
  <div class="page-hero-eyebrow"><span class="dot"></span><span>Партнёры и учредители</span></div>
  <h1 class="page-hero-title" data-text-reveal>Вместе <em>делаем</em> кино</h1>
  <p class="page-hero-lead">Премия существует благодаря государственным институтам, фондам и&nbsp;индустриальным партнёрам, поддерживающим кинематограф Дальнего Востока.</p>
</section>

<section class="partners-list reveal-stagger">
  {partners.map((p, i) => (
    <article class="partner-row">
      <div class="partner-row-logo-box">
        <img class={"partner-row-logo" + (p.invert ? " is-invert" : "")} src={p.logo} alt={p.abbr} />
      </div>
      <div class="partner-row-body">
        <h3 class="partner-row-name" set:html={p.name}></h3>
        <div class="partner-row-meta">{String(i + 1).padStart(2, "0")} · {p.role}</div>
      </div>
      <div class="partner-row-tag">{p.role}</div>
    </article>
  ))}
</section>

</Layout>
